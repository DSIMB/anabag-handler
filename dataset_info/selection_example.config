Parameters for: Antigen
SequenceIdentity = SG60AG # one representative BU per 60 % identity on antigen sequence

Parameters for: Antibody
SequenceIdentity = SG95AB #  one representative BU per 95 % identity on antigen sequence


Parameters for: Complex
InterfaceIdentity = Interface_G_60 # one representative BU per interface cluster defined on antigen 60% identity
pH_pHcrystal	=	6.5,8.0# selecting cases solved close or at physiological pH
resolution	=	0.0,2.5# selecting cases with resolution 2.5 or less


Parameters for: Selection
build_from_pdb = False# If true, will ignore the remaining parameters for selection
per_residue_info = True# Always true except when build_from_pdb is True
rosetta_structures = False# True or False
formatted_structures = True# AG: chain A and AB: chain B
initial_structures = False# ideal for most tasks
hetatm_structures = False# True or False